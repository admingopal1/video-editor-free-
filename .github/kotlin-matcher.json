{
  "problemMatcher": [
    {
      "owner": "kotlin-compile",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^e: file://(.+\\.kt):(\\d+):(\\d+) (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
